# Everything here is optional. With nothing set, the app runs in
# bring-your-own-key mode: each visitor pastes their own provider key, and the
# server never spends a key of its own. The offline checker needs no key at all.

# Let /api/chat fall back to the keys below for visitors who have none.
# Off by default: anyone who can open the page could spend these keys.
ALLOW_OPERATOR_KEYS=0
# Requests per client IP per minute when an operator key is used. The counter
# lives in memory per function instance, so treat it as a speed bump.
RATE_LIMIT_PER_MINUTE=10

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# /api/chat only answers pages served from its own host. List any extra
# origins that should be allowed, comma-separated (e.g. https://my-domain.com).
ALLOWED_ORIGINS=
