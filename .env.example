# ====================================================================
# AceCue — environment variables (ALL OPTIONAL)
# Set any of these in Vercel → Project → Settings → Environment Variables.
#
# AceCue is GUEST-FIRST and BYOK-first: the app works with ZERO server keys.
# Users paste their own provider key in Settings; it is stored only in their
# browser (localStorage), never sent to us, only forwarded to the provider
# for that single request. The vars below are optional operator conveniences.
# ====================================================================

# --- Optional operator LLM keys (operator pays; lets users try with no key) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
ARK_API_KEY=
QIANFAN_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Optional OpenAI-compatible relay (one endpoint, many models) ---
# If set, providers flagged relay-capable route here instead of the official
# upstream. NOTE: third-party relays may violate provider ToS — use at your own risk.
RELAY_BASE_URL=
RELAY_API_KEY=

# --- Optional Supabase (cloud account sync; guest mode needs none of this) ---
# These two are PUBLIC (safe to expose to the browser) and are injected into
# the built frontend. Used only for optional email/password sync of settings,
# résumé, and practice history. BYOK provider keys NEVER sync.
SUPABASE_URL=
SUPABASE_ANON_KEY=
