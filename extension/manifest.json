{
  "manifest_version": 3,
  "name": "AceCue — Interview Copilot",
  "version": "1.0.0",
  "description": "Listens to your interview, detects the question, and shows a fast tailored answer in a discreet floating window. Practice + accessibility aid.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://acecue.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "AceCue",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://acecue.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Show / hide the AceCue overlay"
    },
    "panic-hide": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Instantly hide the overlay (panic)"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
